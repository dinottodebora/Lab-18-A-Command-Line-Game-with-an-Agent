{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build hangman",
            "command": "C:\\Users\\dinot\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\hangman.cpp",
                "-o",
                "${workspaceFolder}\\hangman.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build main.cpp and hangman.cpp with g++."
        }
    ],
    "version": "2.0.0"
}
